# URL pública del proxy del asistente IA (ai-proxy/ desplegado en Vercel), por ejemplo:
# VITE_AI_ENDPOINT=https://mallau-ai-proxy.vercel.app/api/asistente
# Vacío en `pnpm dev`: el asistente usa un mock local y no necesita el proxy.
# En Vercel se define en Settings → Environment Variables del proyecto web (no es secreta).
# La API key de DeepSeek NUNCA va aquí: vive solo en el proxy.
VITE_AI_ENDPOINT=
# true: el asistente usa el mock local aunque haya endpoint (previews de Vercel).
VITE_AI_MOCK=
# Opcional: base de la web (por defecto "/"), p. ej. /utp-malla-optima/ para servirla en una subruta.
VITE_BASE=
